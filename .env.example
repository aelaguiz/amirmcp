# Anthropic key used for Claude Haiku 5.5 summaries.
ANTHROPIC_API_KEY=
# The secret path segment in the public URL. Generate one per machine with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
AMIRMCP_SECRET=
# Optional second secret, generated the same way, for readers that may look but
# not type into agents (Grok Bot): https://<host>/<this>/mcp serves the reading
# tools only.
# AMIRMCP_READ_SECRET=
# How the dot should name this machine, e.g. "Amir-M5" or "home server (amir-server)".
AMIRMCP_MACHINE=
# Machines whose Herdr panes SSH into this one (comma-separated SSH hosts), so
# agents here are shown with the pane they run in. Leave empty on the Mac.
# AMIRMCP_HERDR_HOSTS=amir-m5
# Linux only: when this machine's Tailscale port 443 already serves other
# things, give the connector its own Tailscale node with this name. ChatGPT
# only reaches port 443, so another Funnel port does not work.
# AMIRMCP_TAILSCALE_NODE=home-mcp
# Local port the service listens on.
# AMIRMCP_PORT=8787
