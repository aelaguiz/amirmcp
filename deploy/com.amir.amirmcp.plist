<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.amir.amirmcp</string>
  <!-- The project's own entry point, so starting at login needs no network
       and no uv resolve; `uv sync` (run by install-service.sh) keeps it current. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/aelaguiz/workspace/amirmcp/.venv/bin/amirmcp</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/aelaguiz/workspace/amirmcp</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/aelaguiz/.cargo/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HERDR_BIN</key>
    <string>/Users/aelaguiz/.cargo/bin/herdr</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- Requests go to the rotating ~/Library/Logs/amirmcp/amirmcp.log; this file
       only catches a crash before logging starts. -->
  <key>StandardOutPath</key>
  <string>/Users/aelaguiz/Library/Logs/amirmcp/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/aelaguiz/Library/Logs/amirmcp/launchd.log</string>
</dict>
</plist>
